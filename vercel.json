{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "/api/auth?__subpath=:path" },
    { "source": "/api/erp/:path*", "destination": "/api/erp?__subpath=:path" },
    { "source": "/erp", "destination": "/erp/index.html" },
    { "source": "/erp/:path*", "destination": "/erp/index.html" },
    { "source": "/admin", "destination": "/erp/index.html" },
    { "source": "/login", "destination": "/index.html" },
    { "source": "/portal", "destination": "/index.html" }
  ]
}
